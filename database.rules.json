{
  "rules": {
    ".read": false,
    ".write": false,
    "platformAdmins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "shopIndex": {
      ".read": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true"
    },
    "access": {
      ".read": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$slug": { ".validate": "newData.val() === 'owner' || newData.val() === 'manager'" }
      }
    },
    "shops": {
      ".read": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true",
      "$slug": {
        "settings": {
          ".read": true,
          ".write": "auth != null && (root.child('access').child(auth.uid).child($slug).val() === 'owner' || root.child('access').child(auth.uid).child($slug).val() === 'manager')",
          ".validate": "newData.hasChildren(['nameBn', 'nameEn', 'deliveryCharge', 'active']) && newData.child('nameBn').isString() && newData.child('nameEn').isString() && newData.child('deliveryCharge').isNumber() && newData.child('deliveryCharge').val() >= 0 && newData.child('deliveryCharge').val() <= 1000 && newData.child('active').isBoolean()"
        },
        "categories": {
          ".read": "root.child('shops').child($slug).child('settings').child('active').val() === true || (auth != null && (root.child('access').child(auth.uid).child($slug).val() === 'owner' || root.child('access').child(auth.uid).child($slug).val() === 'manager'))",
          ".write": "auth != null && (root.child('access').child(auth.uid).child($slug).val() === 'owner' || root.child('access').child(auth.uid).child($slug).val() === 'manager')",
          "$categoryId": {
            ".validate": "newData.hasChildren(['bn', 'en', 'tone']) && newData.child('bn').isString() && newData.child('en').isString() && newData.child('tone').isString()"
          }
        },
        "products": {
          ".read": "root.child('shops').child($slug).child('settings').child('active').val() === true || (auth != null && (root.child('access').child(auth.uid).child($slug).val() === 'owner' || root.child('access').child(auth.uid).child($slug).val() === 'manager'))",
          ".write": "auth != null && (root.child('access').child(auth.uid).child($slug).val() === 'owner' || root.child('access').child(auth.uid).child($slug).val() === 'manager')",
          "$productId": {
            ".validate": "newData.hasChildren(['bn', 'en', 'price', 'category', 'active']) && newData.child('bn').isString() && newData.child('en').isString() && newData.child('price').isNumber() && newData.child('price').val() > 0 && newData.child('price').val() <= 100000 && newData.child('category').isString() && newData.child('active').isBoolean()"
          }
        },
        "orders": {
          ".read": "auth != null && (root.child('access').child(auth.uid).child($slug).val() === 'owner' || root.child('access').child(auth.uid).child($slug).val() === 'manager')",
          ".write": "auth != null && (root.child('access').child(auth.uid).child($slug).val() === 'owner' || root.child('access').child(auth.uid).child($slug).val() === 'manager')",
          "$orderId": {
            ".write": "!data.exists() && newData.exists() && root.child('shops').child($slug).child('settings').child('active').val() === true && newData.child('status').val() === 'pending'",
            ".validate": "newData.hasChildren(['name', 'phone', 'address', 'items', 'subtotal', 'shipping', 'total', 'paymentMethod', 'status', 'createdAt']) && newData.child('total').val() === newData.child('subtotal').val() + newData.child('shipping').val()",
            "name": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 100" },
            "phone": { ".validate": "newData.isString() && newData.val().matches(/^(\\+?880|0)1[3-9][0-9]{8}$/)" },
            "address": { ".validate": "newData.isString() && newData.val().length >= 5 && newData.val().length <= 500" },
            "note": { ".validate": "newData.isString() && newData.val().length <= 500" },
            "items": {
              ".validate": "newData.hasChildren()",
              "$itemId": {
                ".validate": "newData.hasChildren(['id', 'bn', 'en', 'price', 'qty']) && newData.child('price').isNumber() && newData.child('qty').isNumber() && newData.child('qty').val() >= 1 && newData.child('qty').val() <= 50"
              }
            },
            "subtotal": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 1000000" },
            "shipping": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000" },
            "total": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 1001000" },
            "paymentMethod": { ".validate": "newData.val() === 'cash_on_delivery'" },
            "status": { ".validate": "newData.val() === 'pending' || newData.val() === 'confirmed' || newData.val() === 'shipped' || newData.val() === 'delivered' || newData.val() === 'cancelled'" },
            "createdAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "$other": { ".validate": false }
          }
        }
      }
    },
    "clientDemo": {
      "settings": {
        ".read": true,
        ".write": "auth != null && auth.token.email === 'admin@gmail.com'",
        ".validate": "newData.hasChildren(['nameBn', 'nameEn', 'deliveryCharge', 'active']) && newData.child('nameBn').isString() && newData.child('nameEn').isString() && newData.child('deliveryCharge').isNumber() && newData.child('deliveryCharge').val() >= 0 && newData.child('deliveryCharge').val() <= 1000 && newData.child('active').isBoolean()"
      },
      "categories": {
        ".read": true,
        ".write": "auth != null && auth.token.email === 'admin@gmail.com'",
        "$categoryId": {
          ".validate": "newData.hasChildren(['bn', 'en', 'tone']) && newData.child('bn').isString() && newData.child('en').isString() && newData.child('tone').isString()"
        }
      },
      "products": {
        ".read": true,
        ".write": "auth != null && auth.token.email === 'admin@gmail.com'",
        "$productId": {
          ".validate": "newData.hasChildren(['bn', 'en', 'price', 'category', 'active', 'available']) && newData.child('bn').isString() && newData.child('en').isString() && newData.child('price').isNumber() && newData.child('price').val() > 0 && newData.child('price').val() <= 100000 && newData.child('category').isString() && newData.child('active').isBoolean() && newData.child('available').isBoolean()"
        }
      },
      "orders": {
        ".read": "auth != null && auth.token.email === 'admin@gmail.com'",
        ".write": "auth != null && auth.token.email === 'admin@gmail.com'",
        "$orderId": {
          ".write": "!data.exists() && newData.exists() && root.child('clientDemo').child('settings').child('active').val() === true && newData.child('status').val() === 'pending'",
          ".validate": "newData.hasChildren(['name', 'phone', 'address', 'items', 'subtotal', 'shipping', 'total', 'paymentMethod', 'status', 'createdAt']) && newData.child('total').val() === newData.child('subtotal').val() + newData.child('shipping').val()",
          "name": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 100" },
          "phone": { ".validate": "newData.isString() && newData.val().matches(/^(\\+?880|0)1[3-9][0-9]{8}$/)" },
          "address": { ".validate": "newData.isString() && newData.val().length >= 5 && newData.val().length <= 500" },
          "note": { ".validate": "newData.isString() && newData.val().length <= 500" },
          "items": { ".validate": "newData.hasChildren()" },
          "subtotal": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 1000000" },
          "shipping": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000" },
          "total": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 1001000" },
          "paymentMethod": { ".validate": "newData.val() === 'cash_on_delivery'" },
          "status": { ".validate": "newData.val() === 'pending' || newData.val() === 'confirmed' || newData.val() === 'shipped' || newData.val() === 'delivered' || newData.val() === 'cancelled'" },
          "createdAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "$other": { ".validate": false }
        }
      }
    },
    "orders": {
      ".read": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true",
      "$orderId": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['name', 'phone', 'address', 'items', 'subtotal', 'shipping', 'total', 'paymentMethod', 'status', 'createdAt']) && newData.child('total').val() === newData.child('subtotal').val() + newData.child('shipping').val()",
        "name": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 100" },
        "phone": { ".validate": "newData.isString() && newData.val().matches(/^(\\+?880|0)1[3-9][0-9]{8}$/)" },
        "address": { ".validate": "newData.isString() && newData.val().length >= 5 && newData.val().length <= 500" },
        "note": { ".validate": "newData.isString() && newData.val().length <= 500" },
        "items": {
          ".validate": "newData.hasChildren()",
          "$itemId": { ".validate": "newData.hasChildren(['id', 'bn', 'en', 'price', 'qty'])" }
        },
        "subtotal": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 1000000" },
        "shipping": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000" },
        "total": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 1001000" },
        "paymentMethod": { ".validate": "newData.val() === 'cash_on_delivery'" },
        "status": { ".validate": "newData.val() === 'pending'" },
        "createdAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "$other": { ".validate": false }
      }
    }
  }
}
